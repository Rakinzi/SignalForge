# API Configuration
VITE_API_URL=/api

# API Authentication (uses viewer role by default for read-only access)
VITE_API_USERNAME=viewer
VITE_API_PASSWORD=viewer

# Production URL (uncomment and set for production)
# VITE_API_URL=https://api.signalforge.example.com
# VITE_API_USERNAME=your_username
# VITE_API_PASSWORD=your_password
